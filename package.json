{
  "name": "@itookit/piagent-driver",
  "version": "0.1.2",
  "description": "Platform-independent client for pi-agent: controlled files, projects, sync, processes and native AI harness sessions.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./harness": "./src/harness/index.ts", "./sync": "./src/sync/client.ts" },
  "scripts": { "typecheck": "tsc --noEmit", "test": "vitest run", "build": "tsup", "prepublishOnly": "pnpm build" },
  "dependencies": { "@itookit/vfs-core": "5.3.2", "@itookit/vfs-sync": "0.1.0", "@modelcontextprotocol/client": "2.0.0" },
  "devDependencies": { "typescript": "^5.9.3", "vitest": "^3.2.4", "tsup": "^8.5.1", "@types/node": "^20.19.25" },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" } },
      "./harness": { "import": { "types": "./dist/harness/index.d.ts", "default": "./dist/harness/index.js" }, "require": { "types": "./dist/harness/index.d.cts", "default": "./dist/harness/index.cjs" } },
      "./sync": { "import": { "types": "./dist/sync/client.d.ts", "default": "./dist/sync/client.js" }, "require": { "types": "./dist/sync/client.d.cts", "default": "./dist/sync/client.cjs" } }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "license": "MIT",
  "author": "lizlok@gmail.com",
  "keywords": ["itookit", "mindos", "pi-agent", "mcp", "filesystem", "sync", "harness"],
  "repository": { "type": "git", "url": "git+https://github.com/mushuanli/piagent-driver.git" },
  "bugs": { "url": "https://github.com/mushuanli/piagent-driver/issues" },
  "homepage": "https://github.com/mushuanli/piagent-driver#readme",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=20" }
}
